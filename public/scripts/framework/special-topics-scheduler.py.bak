# ============================================================
# 调度器核心逻辑
# ============================================================

def get_day_index(base_date_str, period=5):
    """计算从基准日期起的天数（决定主题循环）"""
    base = datetime.strptime(base_date_str, "%Y-%m-%d")
    today = datetime.now()
    return (today - base).days % period

def get_token():
    import requests
    resp = requests.post(
        "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal",
        json={"app_id": APP_ID, "app_secret": APP_SECRET},
        timeout=10
    )
    if resp.status_code == 200 and resp.json().get("code") == 0:
        return resp.json().get("tenant_access_token")
    return None

def build_content(topic_data):
    """将主题数据构建为飞书消息内容"""
    lines = []
    if "theme" in topic_data:
        lines.append(f"**专题**: {topic_data['theme']}  ")
    lines.append("")
    for p in topic_data["points"]:
        lines.append(f"• {p}")
    return "\n".join(lines)

def send_feishu(topic_data, hour, template="blue"):
    import requests
    token = get_token()
    if not token:
        print("获取token失败")
        return False

    category = topic_data.get("category", "学习")
    topic = topic_data["topic"]
    content = build_content(topic_data)

    title = f"📚 [{category}] {topic}"
    footer = f"精读时间：{datetime.now().strftime('%Y-%m-%d')} | {category}每日精读"

    card = {
        "receive_id": USER_ID,
        "msg_type": "interactive",
        "content": json.dumps({
            "config": {"wide_screen_mode": True},
            "header": {"title": {"tag": "plain_text", "content": title}, "template": template},
            "elements": [
                {"tag": "markdown", "content": content},
                {"tag": "markdown", "content": f"---  {footer}"}
            ]
        })
    }

    resp = requests.post(
        "https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=open_id",
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        json=card, timeout=15
    )
    if resp.status_code == 200:
        data = resp.json()
        if data.get("code") == 0:
            return True
        print(f"发送失败: {data.get('msg')}")
    else:
        print(f"请求失败: {resp.status_code}")
    return False

def save_note(topic_data, hour):
    now = datetime.now().strftime('%Y-%m-%d %H:%M')
    safe_topic = topic_data['topic'].replace('/', '-').replace(' ', '-')
    safe_category = topic_data['category'].replace('/', '-').replace(' ', '-')
    filename = f"{now}-{safe_category}-{safe_topic}.md"
    filepath = f"{WORKSPACE}/memory/{filename}"

    lines = [f"# {topic_data['topic']}", "", f"**时间**: {now}", f"**分类**: {topic_data['category']}", ""]
    for p in topic_data['points']:
        lines.append(f"- {p}")

    with open(filepath, 'w', encoding='utf-8') as f:
        f.write("\n".join(lines))
    return filepath

def main():
    hour = datetime.now().hour

    # 时间表 → 主题映射
    SCHEDULE = {
        11: {"data": [], "template": "blue"},    # AI技术（暂保留简单版）
        12: {"data": PSYCHOLOGY_PROGRESSION, "template": "purple"},
        14: {"data": ACCOUNTING_PROGRESSION, "template": "orange"},
        15: {"data": TCM_PROGRESSION, "template": "red"},
        16: {"data": NUMEROLOGY_PROGRESSION, "template": "purple"},
        17: {"data": CHINESE_HISTORY_PROGRESSION, "template": "blue"},
    }

    if len(sys.argv) > 1 and sys.argv[1] == "--check":
        if hour not in SCHEDULE:
            print(f"{hour:02d}:00 - 无专题安排")
            return

        flag_file = f"{WORKSPACE}/memory/.last_push_{hour}"
        if os.path.exists(flag_file):
            print(f"今日{hour}点已推送，跳过")
            return

        entry = SCHEDULE[hour]
        data = entry["data"]
        template = entry["template"]

        if not data:
            print(f"{hour:02d}:00 - AI技术专题，暂跳过")
            return

        # 每天选对应的主题（按天循环）
        day_idx = get_day_index("2026-04-17", len(data))
        topic_data = data[day_idx].copy()
        topic_data["category"] = {
            12: "心理学",
            14: "会计",
            15: "中医",
            16: "命理",
            17: "历史"
        }.get(hour, "学习")

        print(f"[{hour:02d}:00] 推送: {topic_data['topic']}")
        note_file = save_note(topic_data, hour)
        print(f"笔记已保存: {note_file}")
        if send_feishu(topic_data, hour, template):
            with open(flag_file, 'w') as f:
                f.write(datetime.now().strftime('%Y-%m-%d %H:%M'))
            print("飞书通知已发送 ✅")
        else:
            print("飞书通知发送失败 ❌")

    elif len(sys.argv) > 1 and sys.argv[1] == "--force":
        hour = int(sys.argv[2]) if len(sys.argv) > 2 else datetime.now().hour
        if hour in SCHEDULE:
            entry = SCHEDULE[hour]
            data = entry["data"]
            if data:
                topic_data = data[0].copy()
                topic_data["category"] = {
                    12: "心理学", 14: "会计", 15: "中医", 16: "命理", 17: "历史"
                }.get(hour, "学习")
                note_file = save_note(topic_data, hour)
                send_feishu(topic_data, hour, entry["template"])
                print(f"已强制推送 {hour:02d}:00 - {topic_data['topic']}")

    elif len(sys.argv) > 1 and sys.argv[1] == "--today":
        for hour in sorted(SCHEDULE.keys()):
            entry = SCHEDULE[hour]
            data = entry["data"]
            if data:
                topic_data = data[0].copy()
                topic_data["category"] = {
                    12: "心理学", 14: "会计", 15: "中医", 16: "命理", 17: "历史"
                }.get(hour, "学习")
                result = send_feishu(topic_data, hour, entry["template"])
                status = "✅" if result else "❌"
                print(f"{status} [{hour:02d}:00] {topic_data['topic']}")
                import time; time.sleep(1)

    else:
        print("用法: python3 special-topics-scheduler.py --check/--force <hour>/--today")

if __name__ == "__main__":
    main()
